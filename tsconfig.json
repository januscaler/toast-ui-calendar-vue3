{
	"compilerOptions": {
		"target": "ESNext",
		"rootDir": ".",
		"baseUrl": ".",
		"outDir": "dist",
		"module": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"useDefineForClassFields": true,
		"moduleResolution": "node",
		"allowJs": true,
		"strict": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"noImplicitAny": false,
		"noImplicitThis": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"removeComments": false,
		"declaration": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"includes": ["env.d.ts", "node_modules/element-plus/global.d.ts"],
	"exclude": ["node_modules", "dist", "docs", "example", "test"]
}
